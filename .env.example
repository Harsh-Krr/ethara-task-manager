# Environment Variables (copy to .env for local dev)
# Do NOT commit .env to git!

# Required in production (Railway sets DATABASE_URL automatically when you add PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Change this to a long random string in production!
SECRET_KEY=change-this-to-a-long-random-secret-key

# Optional: for local SQLite dev, leave DATABASE_URL unset
